# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development
APP_NAME=NutriSnap-Backend

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
# Kết nối PostgreSQL chạy qua Docker Compose:
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/nutrisnap_db?schema=public"

# Database credentials cho docker-compose:
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=nutrisnap_db
DB_PORT=5432

# ==========================================
# AUTHENTICATION & JWT
# ==========================================
JWT_ACCESS_SECRET=super_secret_access_jwt_key_nutrisnap_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_nutrisnap_2026
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# GOOGLE GEMINI AI
# ==========================================
# Lấy API key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ==========================================
# CLOUDINARY (Lưu trữ ảnh món ăn)
# ==========================================
# Lấy credential tại: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# SECURITY & RATE LIMITING
# ==========================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

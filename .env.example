# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development
APP_NAME=NutriSnap-Backend

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
# Kết nối PostgreSQL chạy qua Docker Compose:
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/nutrisnap_db?schema=public"

# Database credentials cho docker-compose:
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=nutrisnap_db
DB_PORT=5432

# ==========================================
# AUTHENTICATION & JWT
# ==========================================
JWT_ACCESS_SECRET=super_secret_access_jwt_key_nutrisnap_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_nutrisnap_2026
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# GOOGLE GEMINI AI
# ==========================================
# Lấy API key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model trò chuyện AI Coach (500 lượt/ngày, phản hồi siêu nhanh):
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Model thị giác máy tính nhận diện ảnh món ăn & menu (20 lượt/ngày, độ chính xác cao):
GEMINI_VISION_MODEL=gemini-3.6-flash
# Fallback model:
GEMINI_MODEL=gemini-3.6-flash
# Mô hình dự phòng khi mô hình chính báo 503/429/hết thời gian (phân tách bằng dấu phẩy, thử tối đa 3 mô hình)
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite

# Cảnh báo khi AI lỗi nhiều (log mức ERROR "AI_UNAVAILABLE_RATE")
# Báo khi tỉ lệ lượt gọi AI lỗi > AI_ERROR_ALERT_RATE_PCT (%) trong AI_ERROR_ALERT_WINDOW_MIN phút,
# và đã có ít nhất AI_ERROR_ALERT_MIN_SAMPLES lượt gọi trong cửa sổ đó.
AI_ERROR_ALERT_RATE_PCT=20
AI_ERROR_ALERT_WINDOW_MIN=15
AI_ERROR_ALERT_MIN_SAMPLES=5

# Nhận diện ảnh neo vào kho món (BR-11.1)
# Độ tương đồng tên món tối thiểu (0-1) để coi là khớp kho; thấp hơn thì AI ước tính và gắn nhãn "Ước tính".
AI_CATALOG_MATCH_THRESHOLD=0.6
# Calo ước tính lệch quá % này so với 4P+4C+9F thì sửa theo macro
AI_ATWATER_TOLERANCE_PCT=15
# Số món tối đa đề xuất khi quét thực đơn quán (1-5)
AI_MAX_SUGGESTIONS=3

# Bảng giá Gemini (USD cho mỗi 1 triệu token) dùng để tính chi phí AI thật (BR-15.5).
# Mặc định là mức cao của dòng Flash để không đánh giá thấp chi phí; hãy đặt đúng giá hiện hành của model đang dùng.
AI_PRICE_INPUT_USD_PER_MTOK=0.3
AI_PRICE_OUTPUT_USD_PER_MTOK=2.5

# Kho món trong cơ sở dữ liệu (BR-08.1)
# Thời gian giữ kho trong bộ nhớ (giây) trước khi nạp lại; admin sửa kho thì làm mới ngay trên máy chủ đó.
FOOD_CATALOG_CACHE_TTL_SEC=300
# Độ tương đồng tối thiểu (0-1) để món gần giống tên người dùng gõ vẫn được trả về khi tra cứu
FOOD_SEARCH_SIMILARITY_MIN=0.6

# ==========================================
# CLOUDINARY (Lưu trữ ảnh món ăn)
# ==========================================
# Lấy credential tại: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# GOOGLE SIGN-IN (SSO)
# ==========================================
# Web Client ID lấy từ Firebase Console > Project Settings > hoặc Google Cloud Console > Credentials
# (dùng chung ID này cho cả app Android khi gọi Credential Manager và server để verify idToken)
GOOGLE_CLIENT_ID=your_google_web_client_id_here

# ==========================================
# SMTP (Gửi email xác thực tài khoản)
# ==========================================
# Ví dụ dùng Gmail: bật 2FA rồi tạo App Password tại https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM="NutriWise <no-reply@nutriwise.app>"

# ==========================================
# SECURITY & RATE LIMITING
# ==========================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=60


# =====================================================
# THANH TOÁN GOOGLE PLAY (BR-16)
# =====================================================
GOOGLE_PLAY_PACKAGE_NAME=com.calai.app
# Nội dung JSON của service account (hoặc đường dẫn tới file JSON) có quyền Google Play Developer API
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Cấu hình Pub/Sub push: audience và email service account ký JWT
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=
# Bật chặn 402 PREMIUM_REQUIRED cho tính năng Premium (chỉ bật sau khi mua hàng chạy được)
BILLING_ENFORCE=false

# =====================================================
# THANH TOÁN QR NGÂN HÀNG (VietQR)
# =====================================================
# BIN ngân hàng theo danh sách VietQR (MB Bank = 970422)
BANK_BIN=970422
BANK_ACCOUNT_NO=908112006
BANK_ACCOUNT_NAME=LE THI THAO
BANK_NAME=MB Bank


# Khoá API do bạn tự đặt, nhập cùng giá trị vào cấu hình webhook của SePay (header Authorization: Apikey <khoá>)
SEPAY_API_KEY=

# Chỉ để thử giao diện QR ở máy dev khi chưa có tài khoản thật: dùng tài khoản NHẬN TIỀN GIẢ. Không bao giờ bật khi chạy thật.
ALLOW_DEV_BANK_FALLBACK=false

# =====================================================
# TẠO TÀI KHOẢN QUẢN TRỊ (npm run seed:admin)
# =====================================================
# Bắt buộc khai báo email. Không đặt ADMIN_PASSWORD thì script tạo mật khẩu ngẫu nhiên và in ra MỘT lần.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =====================================================
# QUẢN TRỊ & PHÁT HÀNH
# =====================================================
# Khoá mã hoá bí mật TOTP của admin (>= 32 ký tự ngẫu nhiên). Bỏ trống thì dẫn xuất từ JWT_ACCESS_SECRET (không nên dùng khi phát hành).
ADMIN_TOTP_ENC_KEY=
# Tên miền được gọi API từ trình duyệt (web quản trị), phân cách bằng dấu phẩy. Bỏ trống = mở cho mọi nơi (chỉ dev).
CORS_ORIGINS=


# ── KHO LƯU TRỮ TỆP (ảnh đại diện) ─────────────────────────────────────────────
# local: ghi vào ./uploads (chỉ để phát triển). s3: kho tương thích S3 (AWS S3, Cloudflare R2, MinIO, Supabase Storage...).
STORAGE_DRIVER=local
# Dùng Cloudinary: đặt STORAGE_DRIVER=cloudinary rồi điền 3 dòng CLOUDINARY_* bên dưới (S3_* khi đó bị bỏ qua)
# Chỉ cần khi STORAGE_DRIVER=s3:
S3_BUCKET=
# Cloudflare R2 dùng region "auto"; AWS dùng vùng thật, ví dụ ap-southeast-1
S3_REGION=auto
# Để trống với AWS S3. R2: https://<account_id>.r2.cloudflarestorage.com ; MinIO: http://host:9000
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Địa chỉ công khai để ứng dụng tải ảnh (tên miền CDN/bucket công khai), ví dụ https://cdn.example.com
S3_PUBLIC_BASE_URL=
# true với MinIO và một số kho tự dựng
S3_FORCE_PATH_STYLE=false

# ── CLOUDINARY (STORAGE_DRIVER=cloudinary) ─────────────────────────────────────
# Lấy ở Cloudinary Console > Settings > API Keys. Cloud name nằm ở góc trên bên trái Console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Chỉ để ở .env của máy chủ, không đưa vào app hay Git
CLOUDINARY_API_SECRET=
# Thư mục chứa ảnh trên Cloudinary (tuỳ chọn)
CLOUDINARY_FOLDER=nutriwise

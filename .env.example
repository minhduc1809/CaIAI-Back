# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development
APP_NAME=NutriSnap-Backend

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
# Kết nối PostgreSQL chạy qua Docker Compose:
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/nutrisnap_db?schema=public"

# Database credentials cho docker-compose:
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=nutrisnap_db
DB_PORT=5432

# ==========================================
# AUTHENTICATION & JWT
# ==========================================
JWT_ACCESS_SECRET=super_secret_access_jwt_key_nutrisnap_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_nutrisnap_2026
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# GOOGLE GEMINI AI
# ==========================================
# Lấy API key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ==========================================
# CLOUDINARY (Lưu trữ ảnh món ăn)
# ==========================================
# Lấy credential tại: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# GOOGLE SIGN-IN (SSO)
# ==========================================
# Web Client ID lấy từ Firebase Console > Project Settings > hoặc Google Cloud Console > Credentials
# (dùng chung ID này cho cả app Android khi gọi Credential Manager và server để verify idToken)
GOOGLE_CLIENT_ID=your_google_web_client_id_here

# ==========================================
# SMTP (Gửi email xác thực tài khoản)
# ==========================================
# Ví dụ dùng Gmail: bật 2FA rồi tạo App Password tại https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM="NutriWise <no-reply@nutriwise.app>"

# ==========================================
# SECURITY & RATE LIMITING
# ==========================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

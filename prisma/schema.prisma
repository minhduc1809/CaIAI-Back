datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GoalType {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_WEIGHT
}

enum MacroStyle {
  BALANCED
  HIGH_CARB_LOW_FAT
  LOW_CARB_HIGH_FAT
  KETO
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum StressLevel {
  LOW
  MEDIUM
  HIGH
}

enum DietType {
  BALANCED
  VEGETARIAN
  VEGAN
  KETO
  LOW_CARB
  PESCATARIAN
  OTHER
}

enum FoodBudgetLevel {
  LOW
  MEDIUM
  HIGH
}

enum ServingUnit {
  GRAM
  ML
  PORTION
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum WorkoutLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingGoal {
  BUILD_MUSCLE
  LOSE_FAT
  STRENGTH
  ENDURANCE
  RECOMP
  GENERAL_FITNESS
}

enum SessionsPerWeek {
  ONE_TO_TWO
  THREE_TO_FOUR
  FIVE_TO_SIX
  SEVEN
}

enum EquipmentAccess {
  FULL_GYM
  BASIC_GYM
  HOME_DUMBBELL
  BODYWEIGHT_ONLY
}

enum ProgramType {
  COACHED
  COLLABORATIVE
  MANUAL
}

enum ProteinPreference {
  LOW
  MID
  HIGH
  VERY_HIGH
}

enum CheckInStatus {
  PENDING
  ACCEPTED
  DECLINED
  DISMISSED
}

enum Mood {
  GREAT
  GOOD
  OKAY
  BAD
  TERRIBLE
}

enum CheckInAdjustmentReason {
  EXPENDITURE_CHANGE
  GOAL_CHANGE
  SMOOTHING
  NO_CHANGE
}

enum WorkoutCategory {
  STRENGTH
  CARDIO
  RUNNING
  CYCLING
  SWIMMING
  HIIT
  WALKING
  YOGA
  SPORTS
  OTHER
}

model User {
  id       String  @id @default(uuid())
  username String  @unique
  email    String? @unique
  password String?
  name     String?
  avatar   String?
  role     Role    @default(USER)
  isActive Boolean @default(true)

  // Đăng nhập & xác thực email
  authProvider               AuthProvider @default(LOCAL)
  googleId                   String?      @unique
  isEmailVerified            Boolean      @default(false)
  emailVerifiedAt            DateTime?
  emailVerificationCode      String?
  emailVerificationExpiresAt DateTime?

  gender              Gender?
  dateOfBirth         DateTime?
  heightCm            Float?
  weightKg            Float?
  targetWeightKg      Float?
  weightRateKgPerWeek Float?         @default(0.5)
  bodyFatPercent      Float?
  activityLevel       ActivityLevel? @default(SEDENTARY)
  goal                GoalType?      @default(MAINTAIN)
  macroStyle          MacroStyle?    @default(BALANCED)

  // Lifestyle Profile (BRD Onboarding — nhóm 6/7)
  sleepHours       Float?
  stressLevel      StressLevel? @default(MEDIUM)
  takesSupplements Boolean?     @default(false)

  // Nutrition Profile (BRD Onboarding — nhóm 7/7)
  dietType        DietType?        @default(BALANCED)
  mealsPerDay     Int?             @default(3)
  cookTimeMinutes Int?             @default(30)
  foodBudgetLevel FoodBudgetLevel? @default(MEDIUM)

  // Training Profile (BRD Onboarding)
  trainingExperience  WorkoutLevel?    @default(BEGINNER)
  trainingGoal        TrainingGoal?    @default(GENERAL_FITNESS)
  sessionsPerWeek     SessionsPerWeek? @default(THREE_TO_FOUR)
  equipmentAccess     EquipmentAccess? @default(BODYWEIGHT_ONLY)
  injuries            String[]         @default([])
  injuriesOtherNote   String?
  oneRepMaxSquatKg    Float?
  oneRepMaxBenchKg    Float?
  oneRepMaxDeadliftKg Float?

  // Program Setup (BRD Onboarding / Goals & Program)
  programType       ProgramType?       @default(COACHED)
  proteinPreference ProteinPreference? @default(MID)

  // Nutrition Profile — Intermittent Fasting
  isIntermittentFasting Boolean? @default(false)
  ifWindowStart         String?
  ifWindowEnd           String?

  bmi            Float?
  bmr            Float?
  tdee           Float?
  targetCalories Float?
  targetProtein  Float?
  targetCarb     Float?
  targetFat      Float?

  // Adaptive Expenditure Engine — ước tính TDEE thích ứng theo dữ liệu thực tế (cân nặng + calo đã log)
  adaptiveExpenditure  Float?
  expenditureStatus    String    @default("UPDATING") // UPDATING | HOLDING
  expenditureUpdatedAt DateTime?

  dailyAiQuota       Int     @default(10)
  purchasedAiQuota   Int     @default(0)
  purchasedChatQuota Int     @default(0)
  refreshTokenHash   String?
  timezone         String  @default("Asia/Ho_Chi_Minh")

  meals         Meal[]
  weightLogs    WeightLog[]
  workoutLogs   WorkoutLog[]
  customFoods   CustomFood[]
  favoriteFoods FavoriteFood[]
  aiMessages    AiMessage[]
  apiUsageLogs  ApiUsageLog[]
  checkIns      CheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
}

model Meal {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealType MealType @default(LUNCH)
  date     DateTime
  imageUrl String?

  totalCalories Float @default(0)
  totalProtein  Float @default(0)
  totalCarb     Float @default(0)
  totalFat      Float @default(0)

  items MealItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model MealItem {
  id            String       @id @default(uuid())
  mealId        String
  meal          Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name          String
  servingSize   String?
  servingAmount Float?
  servingUnit   ServingUnit? @default(PORTION)
  quantity      Float        @default(1)
  calories      Float
  protein       Float
  carb          Float
  fat           Float
  source        String       @default("manual")
}

model WeightLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg Float
  note     String?
  date     DateTime @default(now())

  @@index([userId, date])
}

model CustomFood {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  servingSize   String?
  servingAmount Float?
  servingUnit   ServingUnit? @default(PORTION)
  calories      Float
  protein       Float        @default(0)
  carb          Float        @default(0)
  fat           Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
}

model FavoriteFood {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodName  String
  createdAt DateTime @default(now())

  @@unique([userId, foodName])
  @@index([userId])
}

model DietPlanTemplate {
  id           String   @id @default(uuid())
  goal         GoalType
  title        String
  description  String?
  targetCalo   Float
  mealsSummary Json
  createdAt    DateTime @default(now())
}

model WorkoutPlanTemplate {
  id          String       @id @default(uuid())
  goal        GoalType
  level       WorkoutLevel @default(BEGINNER)
  title       String
  description String?
  schedule    Json
  createdAt   DateTime     @default(now())
}

model AiMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ApiUsageLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  promptTokens Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model WorkoutLog {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  category        WorkoutCategory @default(CARDIO)
  date            DateTime        @default(now())
  durationMinutes Int
  caloriesBurned  Float           @default(0)
  rpe             Int?
  note            String?

  exercises WorkoutExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model WorkoutExercise {
  id           String       @id @default(uuid())
  workoutLogId String
  workoutLog   WorkoutLog   @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  name         String
  order        Int          @default(0)
  sets         WorkoutSet[]

  @@index([workoutLogId])
}

model WorkoutSet {
  id         String          @id @default(uuid())
  exerciseId String
  exercise   WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setNumber  Int
  reps       Int
  weightKg   Float           @default(0)
  rpe        Int?

  @@index([exerciseId])
}

model CheckIn {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber  Int     // Tuần thứ N kể từ khi tạo program
  weekStartDate DateTime
  weekEndDate   DateTime
  status        CheckInStatus @default(PENDING)

  // Tổng hợp dữ liệu tuần qua
  avgDailyCalories Float?
  avgDailyProtein  Float?
  avgDailyCarb     Float?
  avgDailyFat      Float?
  weightAtCheckin  Float?     // Trend weight tại thời điểm check-in
  compliancePct    Float?     // % ngày đạt ≥80% target calo

  // Đề xuất mới (công thức C018 ±10% guardrail)
  currentCalorieTarget  Int
  proposedCalorieTarget Int
  currentProteinTarget  Float?
  proposedProteinTarget Float?
  currentCarbTarget     Float?
  proposedCarbTarget    Float?
  currentFatTarget      Float?
  proposedFatTarget     Float?

  // Expenditure estimate mới
  newExpenditure    Float?
  adjustmentReason  CheckInAdjustmentReason @default(EXPENDITURE_CHANGE)

  // Goal progress (% hướng tới goal weight)
  goalProgressPct   Float @default(0)

  // User input
  mood  Mood?
  note  String?

  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, weekStartDate])
  @@index([userId, status])
  @@index([userId, createdAt])
}

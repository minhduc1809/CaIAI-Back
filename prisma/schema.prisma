datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PregnancyStatus {
  NONE
  PREGNANT
  LACTATING
}

enum GoalType {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_WEIGHT
}

enum MacroStyle {
  BALANCED
  HIGH_CARB_LOW_FAT
  LOW_CARB_HIGH_FAT
  KETO
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum StressLevel {
  LOW
  MEDIUM
  HIGH
}

enum DietType {
  OMNIVORE // Ăn tạp
  PESCATARIAN // Ăn cá, không ăn thịt
  VEGETARIAN // Ăn chay (không thịt, cá)
  VEGAN // Thuần chay
  HALAL // Không thịt heo
}

enum FoodBudgetLevel {
  LOW
  MEDIUM
  HIGH
}

enum ServingUnit {
  GRAM
  ML
  PORTION
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum WorkoutLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingGoal {
  BUILD_MUSCLE
  LOSE_FAT
  STRENGTH
  ENDURANCE
  RECOMP
  GENERAL_FITNESS
}

enum SessionsPerWeek {
  ONE_TO_TWO
  THREE_TO_FOUR
  FIVE_TO_SIX
  SEVEN
}

enum EquipmentAccess {
  FULL_GYM
  BASIC_GYM
  HOME_DUMBBELL
  BODYWEIGHT_ONLY
}

enum ProgramType {
  COACHED
  COLLABORATIVE
  MANUAL
}

enum ProteinPreference {
  LOW
  MID
  HIGH
  VERY_HIGH
}

enum CheckInStatus {
  PENDING
  ACCEPTED
  DECLINED
  SNOOZED // "Để sau": tự quay lại PENDING sau 24 giờ (trước đây là DISMISSED)
  EXPIRED // sang kỳ mới hoặc mục tiêu đã đổi nên đề xuất không còn phù hợp
  INSUFFICIENT_DATA // chưa đủ dữ liệu để đề xuất; chỉ có thể "Đã hiểu"
  ACKNOWLEDGED // người dùng đã bấm "Đã hiểu" với Check-in thiếu dữ liệu
}

enum Mood {
  GREAT
  GOOD
  OKAY
  BAD
  TERRIBLE
}

enum CheckInAdjustmentReason {
  EXPENDITURE_CHANGE
  GOAL_CHANGE
  SMOOTHING
  NO_CHANGE
}

enum WorkoutCategory {
  STRENGTH
  CARDIO
  RUNNING
  CYCLING
  SWIMMING
  HIIT
  WALKING
  YOGA
  SPORTS
  OTHER
}

model User {
  id       String  @id @default(uuid())
  username String  @unique
  email    String? @unique
  password String?
  name     String?
  avatar   String?
  role     Role    @default(USER)
  isActive Boolean @default(true)

  // Đăng nhập & xác thực email
  authProvider               AuthProvider @default(LOCAL)
  googleId                   String?      @unique
  isEmailVerified            Boolean      @default(false)
  emailVerifiedAt            DateTime?
  emailVerificationCode      String?
  emailVerificationExpiresAt DateTime?
  passwordResetCode          String?
  passwordResetExpiresAt     DateTime?

  gender              Gender?
  pregnancyStatus     PregnancyStatus? @default(NONE)
  dateOfBirth         DateTime?
  heightCm            Float?
  weightKg            Float?
  targetWeightKg      Float?
  weightRateKgPerWeek Float?         @default(0.5)
  weightRatePercent   Float?         // % cân nặng mỗi tuần (BR-02.3: an toàn 0.25%–1.0%/tuần)
  bodyFatPercent      Float?
  activityLevel       ActivityLevel? @default(SEDENTARY)
  goal                GoalType?      @default(MAINTAIN)
  macroStyle          MacroStyle?    @default(BALANCED)
  targetLimitedBy     TargetLimit?
  allergies           String[]       @default([]) // Dị ứng/kiêng thực phẩm (Onboarding Q050) — dùng để lọc gợi ý món AI
  onboardingDraft     Json?          // Lưu nháp Onboarding (BR-02.4: step + dữ liệu nháp)

  // Lifestyle Profile (BRD Onboarding — nhóm 6/7)
  sleepHours       Float?
  stressLevel      StressLevel? @default(MEDIUM)
  takesSupplements Boolean?     @default(false)

  // Nutrition Profile (BRD Onboarding — nhóm 7/7)
  dietType        DietType?        @default(OMNIVORE)
  mealsPerDay     Int?             @default(3)
  cookTimeMinutes Int?             @default(30)
  foodBudgetLevel FoodBudgetLevel? @default(MEDIUM)

  // Training Profile (BRD Onboarding)
  trainingExperience  WorkoutLevel?    @default(BEGINNER)
  trainingGoal        TrainingGoal?    @default(GENERAL_FITNESS)
  sessionsPerWeek     SessionsPerWeek? @default(THREE_TO_FOUR)
  trainingDaysPerWeek Int? // 0–7; nguồn duy nhất để suy ra activityLevel (BR-03.2, BR-03.6)
  equipmentAccess     EquipmentAccess? @default(BODYWEIGHT_ONLY)
  injuries            String[]         @default([])
  injuriesOtherNote   String?
  oneRepMaxSquatKg    Float?
  oneRepMaxBenchKg    Float?
  oneRepMaxDeadliftKg Float?

  // Program Setup (BRD Onboarding / Goals & Program)
  programType       ProgramType?       @default(COACHED)
  proteinPreference ProteinPreference? @default(MID)

  // Nutrition Profile — Intermittent Fasting
  isIntermittentFasting Boolean? @default(false)
  ifWindowStart         String?
  ifWindowEnd           String?

  bmi            Float?
  bmr            Float?
  tdee           Float?
  targetCalories Float?
  targetProtein  Float?
  targetCarb     Float?
  targetFat      Float?

  // Adaptive Expenditure Engine — ước tính TDEE thích ứng theo dữ liệu thực tế (cân nặng + calo đã log)
  adaptiveExpenditure  Float?
  expenditureStatus    String    @default("UPDATING") // UPDATING | HOLDING
  expenditureUpdatedAt DateTime?

  dailyAiQuota       Int       @default(10)
  purchasedAiQuota   Int       @default(0)
  purchasedChatQuota Int       @default(0)
  refreshTokenHash   String?
  timezone           String    @default("Asia/Ho_Chi_Minh")
  lastExportAt       DateTime? // lần xuất dữ liệu gần nhất (BR-18: tối đa 1 lần/ngày)
  checkinDay         Int       @default(1) // ngày Check-in hằng tuần (BR-06.1): 1 = Thứ Hai … 7 = Chủ Nhật
  activityCheckAt    DateTime? // lần gần nhất người dùng xử lý đề xuất đối chiếu số buổi tập (BR-10.7)

  // Cài đặt cá nhân đồng bộ giữa các thiết bị (BR-19.4)
  weightUnit              String  @default("kg") // kg | lb
  heightUnit              String  @default("cm") // cm | ft
  energyUnit              String  @default("kcal") // kcal | kJ
  dailyCompletionReminder String? @default("21:00") // HH:mm, null = tắt nhắc "ghi đủ hôm nay"
  defaultRestSec          Int     @default(90) // nghỉ mặc định giữa set (giây)
  notificationPrefs       Json? // chỉ liệt kê loại đã tắt: { "WEEKLY_SUMMARY_READY": false }
  settingsInitialized     Boolean @default(false) // app đã đẩy cài đặt cũ trên máy lên server chưa

  // Đồng ý chính sách quyền riêng tư lúc đăng ký (BR-18): phiên bản và thời điểm
  privacyAcceptedVersion  String?
  privacyAcceptedAt       DateTime?

  meals                Meal[]
  weightLogs           WeightLog[]
  workoutLogs          WorkoutLog[]
  customFoods          CustomFood[]
  favoriteFoods        FavoriteFood[]
  foodSubmissions      FoodSubmission[]
  aiMessages           AiMessage[]
  apiUsageLogs         ApiUsageLog[]
  checkIns             CheckIn[]
  weeklySummaries      WeeklySummary[]
  habitReminders       HabitReminder[]
  waterLogs            WaterLog[]
  notifications        Notification[]
  usageCounters        UsageCounter[]
  targetChanges        TargetChange[]
  dailyLogStatuses     DailyLogStatus[]
  expenditureSnapshots ExpenditureSnapshot[]
  subscriptionState    SubscriptionState?
  purchases            Purchase[]
  manualGrants         ManualGrant[]
  paymentOrders        PaymentOrder[]
  goals                Goal[]
  customExercises      CustomExercise[]
  workoutRoutines      WorkoutRoutine[]
  personalRecords      PersonalRecord[]
  refreshSessions      RefreshSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
}

model Meal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealType  MealType @default(LUNCH)
  date      DateTime
  // Ngày của bữa ăn theo múi giờ của user, tính MỘT LẦN lúc tạo (BR-07.2). Mọi API theo ngày lọc theo cột này.
  logDate   DateTime @db.Date
  imageUrl  String?
  // Khoá chống ghi trùng: băm nội dung bữa + khung 2 phút. Cùng nội dung gửi lại trong khung (bấm đúp, thử lại sau
  // khi mạng chập chờn) chỉ ra MỘT bữa. Bữa sao chép/cũ không có khoá (null).
  dedupeKey       String?
  clientRequestId String? // UUID từ client khi bấm Lưu để idempotency (BR-07.5)

  totalCalories Float @default(0)
  totalProtein  Float @default(0)
  totalCarb     Float @default(0)
  totalFat      Float @default(0)

  items MealItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dedupeKey])
  @@unique([userId, clientRequestId])
  @@index([userId, date])
  @@index([userId, logDate])
}

model MealItem {
  id            String       @id @default(uuid())
  mealId        String
  meal          Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name          String
  servingSize   String?
  servingAmount Float?
  servingUnit   ServingUnit? @default(PORTION)
  quantity      Float        @default(1)
  calories      Float
  protein       Float
  carb          Float
  fat           Float
  source        String       @default("manual")
  sourceType    String?      // CATALOG | CUSTOM | BARCODE | AI_MATCHED | AI_ESTIMATE | QUICK_ADD | DIET_PLAN (BR-07.3)
  sourceId      String?
}

model WeightLog {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg    Float
  note        String?
  date        DateTime  @default(now())
  // Thứ tự nhập thật, dùng khi nhiều lần cân trùng ngày/giờ (BR-09.4)
  createdAt   DateTime  @default(now())
  isOutlier   Boolean   @default(false) // Cờ cân ngoại lai (BR-05.3)
  confirmedAt DateTime? // Mốc thời gian được xác nhận bởi lần cân kế tiếp (BR-05.3)

  @@index([userId, date])
}

// Ghi lại 1 lần Adaptive Expenditure Engine tính lại VÀ lưu vào User (log cân nặng mới, cập nhật hồ sơ,
// Weekly Check-in) — KHÔNG ghi khi chỉ xem màn hình (GET expenditure status đọc lại không snapshot).
// Dùng để vẽ biểu đồ Expenditure thích ứng vs TDEE tĩnh theo thời gian (NUTRITION > Nutrition Progress).
model ExpenditureSnapshot {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adaptiveExpenditure Float?
  staticTdee          Float?
  status              String    // STATIC | LEARNING | STABLE | STALE (BR-05.5)
  snapshotDate        DateTime? @db.Date // Khoá ngày theo múi giờ user (BR-05.7)
  recordedAt          DateTime  @default(now())

  @@unique([userId, snapshotDate])
  @@index([userId, recordedAt])
}

// Phiên đăng nhập nhiều thiết bị và xoay vòng token (BR-01.3)
model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  deviceName String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  replacedBy String?   // ID của session mới thay thế

  @@index([userId, revokedAt])
}

model CustomFood {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  servingSize   String?
  servingAmount Float?
  servingUnit   ServingUnit? @default(PORTION)
  calories      Float
  protein       Float        @default(0)
  carb          Float        @default(0)
  fat           Float        @default(0)
  // Công thức nhiều nguyên liệu (Recipe) — mảng [{name, servingSize?, calories, protein, carb, fat}].
  // null/rỗng = món đơn giản nhập tổng calo/macro trực tiếp như trước (không phá dữ liệu cũ).
  ingredients   Json?
  // Mã vạch do người dùng gắn khi OpenFoodFacts không có sản phẩm (BR-08.6)
  barcode       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([userId, barcode])
}

model FavoriteFood {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodName  String
  // Định danh món (BR-08.3): đổi tên món trong kho không làm mất yêu thích. Null với dữ liệu cũ chưa tra được.
  sourceType String? // CATALOG | CUSTOM
  sourceId   String?
  createdAt DateTime @default(now())

  @@unique([userId, foodName])
  @@index([userId])
  @@index([userId, sourceType, sourceId])
}

model DietPlanTemplate {
  id           String   @id @default(uuid())
  goal         GoalType
  title        String
  description  String?
  targetCalo   Float
  mealsSummary Json
  createdAt    DateTime @default(now())
}

model WorkoutPlanTemplate {
  id          String       @id @default(uuid())
  goal        GoalType
  level       WorkoutLevel @default(BEGINNER)
  title       String
  description String?
  schedule    Json
  createdAt   DateTime     @default(now())
}

model AiMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  safetyFlag String? // chủ đề rủi ro đã kích hoạt chế độ an toàn (BR-11.6); null = tin nhắn bình thường
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Kho món ăn (BR-08.1). Số liệu dinh dưỡng theo KHẨU PHẦN CHUẨN `servingSize` (đúng như kho cũ trong code); đơn vị
// khẩu phần kiểu Việt và quy đổi theo 100 g thuộc E6. Món chưa được gắn thẻ an toàn (`safetyTagged = false`) bị loại khỏi
// mọi gợi ý (fail-closed) cho tới khi có allergens và các cờ chế độ ăn.
model FoodCatalog {
  id             String   @id @default(uuid())
  name           String   @unique
  nameNormalized String // không dấu, chữ thường (tìm kiếm)
  aliases        String[]
  category       String
  servingSize    String
  calories       Float
  protein        Float
  carb           Float
  fat            Float
  note           String?

  // Thẻ an toàn (BR-08.1a, BR-11.5)
  allergens      String[]
  containsMeat   Boolean  @default(false)
  containsFish   Boolean  @default(false)
  containsEgg    Boolean  @default(false)
  containsDairy  Boolean  @default(false)
  containsPork   Boolean  @default(false)
  safetyTagged   Boolean  @default(false)

  source     String   @default("OFFICIAL") // OFFICIAL | COMMUNITY
  dataSource String? // nguồn số liệu của món (bảng thành phần thực phẩm, công thức, quán...)
  // Đơn vị khẩu phần do admin khai báo: [{name, grams, isDefault}] (BR-08.2); null thì suy ra từ servingSize
  units      Json?
  isActive   Boolean  @default(true)
  // Món chưa được người có chuyên môn rà soát số liệu (BR-08.1); admin bỏ cờ sau khi rà soát
  needsReview Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category, isActive])
  @@index([nameNormalized])
}

model ApiUsageLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  model        String?  // model Gemini đã gọi (BR-15.5)
  promptTokens Int      @default(0) // promptTokenCount THẬT từ usageMetadata của Gemini
  outputTokens Int      @default(0) // candidatesTokenCount THẬT
  costUsd      Float    @default(0) // tính theo bảng giá AI_PRICE_*_USD_PER_MTOK
  latencyMs    Int?
  status       String   @default("OK") // OK | OK_NO_USAGE (Gemini không trả usageMetadata) | ERROR
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model WorkoutLog {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  category        WorkoutCategory @default(CARDIO)
  date            DateTime        @default(now())
  durationMinutes Int
  caloriesBurned  Float           @default(0)
  rpe             Int?
  note            String?
  // BR-10.4: chống ghi trùng khi app gửi lại (offline), và mốc giờ bắt đầu/kết thúc của phiên tập
  clientRequestId String?
  startedAt       DateTime?
  endedAt         DateTime?

  exercises WorkoutExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clientRequestId])
  @@index([userId, date])
}

model WorkoutExercise {
  id           String       @id @default(uuid())
  workoutLogId String
  workoutLog   WorkoutLog   @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  name         String
  order        Int          @default(0)
  // BR-10.3: nguồn bài tập (CATALOG | CUSTOM) và mã trong kho; bài cũ chỉ có tên nên để trống
  exerciseSource String?
  exerciseRefId  String?
  primaryMuscle  String? // ảnh chụp nhóm cơ chính lúc ghi, phục vụ thống kê set theo nhóm cơ
  restSec        Int?
  // Khoá thống nhất của bài ("CATALOG:<id>" | "CUSTOM:<id>" | "name:<tên không dấu>") để gom lịch sử và kỷ lục
  exerciseKey    String?
  sets         WorkoutSet[]

  @@index([workoutLogId])
  @@index([exerciseKey])
}

model WorkoutSet {
  id         String          @id @default(uuid())
  exerciseId String
  exercise   WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setNumber  Int
  reps       Int
  weightKg   Float           @default(0)
  rpe        Float? // bước 0,5 (BR-10.4)
  isWarmup   Boolean         @default(false) // set khởi động không tính volume và kỷ lục
  durationSec Int?
  distanceM  Float?

  @@index([exerciseId])
}

// Bài tập do người dùng tự tạo; chỉ người đó thấy (BR-10.3).
model CustomExercise {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  primaryMuscle String
  equipment     String   @default("NO_EQUIPMENT")
  kind          String   @default("STRENGTH") // STRENGTH | CARDIO | OTHER
  createdAt     DateTime @default(now())

  @@unique([userId, name])
}

// Buổi tập mẫu (BR-10.6). `items` là danh sách bài và số set/reps/tạ gợi ý.
model WorkoutRoutine {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  WorkoutCategory @default(STRENGTH)
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Kỷ lục cá nhân tính sẵn (BR-10.8). Tính lại mỗi khi sửa/xoá set hoặc buổi liên quan.
model PersonalRecord {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseKey  String // "CATALOG:<id>" | "CUSTOM:<id>" | "name:<tên không dấu>"
  exerciseName String
  type         String // MAX_WEIGHT | MAX_REPS_AT_WEIGHT | EST_1RM | MAX_REPS_BODYWEIGHT
  weightKey    Float    @default(0) // mức tạ của kỷ lục MAX_REPS_AT_WEIGHT; các loại khác là 0
  value        Float
  reps         Int?
  weightKg     Float?
  setId        String?
  workoutId    String?
  achievedAt   DateTime

  @@unique([userId, exerciseKey, type, weightKey])
  @@index([userId, exerciseKey])
}

model WeeklySummary {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate DateTime
  weekEndDate   DateTime

  avgCalories       Float?
  avgProtein        Float?
  avgFat            Float?
  avgCarb           Float?
  weightChangeKg    Float?
  workoutsCompleted Int     @default(0)
  highlightText     String
  isFallback        Boolean @default(false)

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, weekStartDate])
  @@index([userId, createdAt])
}

model CheckIn {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber    Int // Tuần thứ N kể từ khi tạo program
  weekStartDate DateTime
  weekEndDate   DateTime
  status        CheckInStatus @default(PENDING)

  // Tổng hợp dữ liệu tuần qua
  avgDailyCalories Float?
  avgDailyProtein  Float?
  avgDailyCarb     Float?
  avgDailyFat      Float?
  weightAtCheckin  Float? // Trend weight tại thời điểm check-in
  compliancePct    Float? // % ngày đạt ≥80% target calo

  // Đề xuất mới (công thức C018 ±10% guardrail)
  currentCalorieTarget  Int
  proposedCalorieTarget Int
  currentProteinTarget  Float?
  proposedProteinTarget Float?
  currentCarbTarget     Float?
  proposedCarbTarget    Float?
  currentFatTarget      Float?
  proposedFatTarget     Float?

  // Expenditure estimate mới
  newExpenditure   Float?
  adjustmentReason CheckInAdjustmentReason @default(EXPENDITURE_CHANGE)

  // Goal progress (% hướng tới goal weight)
  goalProgressPct Float @default(0)

  // User input
  mood Mood?
  note String?

  // Số ngày ĐẦY ĐỦ trong kỳ dữ liệu và việc cần làm khi thiếu dữ liệu (chỉ có với INSUFFICIENT_DATA)
  completeDays Int?
  dataNeeds    Json?

  // Phiên bản tham số hệ thống lúc tính Check-in này (BR-19.2)
  configVersion Int?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, weekStartDate])
  @@index([userId, status])
  @@index([userId, createdAt])
}

enum ReminderType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  WATER
  CUSTOM
}

// Nhắc nhở bữa ăn/uống nước có gắn mục tiêu dinh dưỡng + món ăn cụ thể (Habit Reminder).
// 5 nhắc mặc định (Breakfast/Lunch/Dinner/Snack/Water) được tự seed cho mỗi user ở lần GET đầu tiên,
// tương đương đúng bộ mặc định trước đây chỉ nằm trong SharedPreferences phía App.
model HabitReminder {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    ReminderType @default(CUSTOM)
  label   String // "Bữa Sáng", "Uống nước", hoặc tên tuỳ chỉnh người dùng đặt
  enabled Boolean      @default(true)

  timeOfDay   String // Giờ báo chuông "HH:mm"
  windowStart String? // Khung giờ ăn lý tưởng - bắt đầu "HH:mm"
  windowEnd   String? // Khung giờ ăn lý tưởng - kết thúc "HH:mm"

  targetCalorieMin Float? // Mục tiêu calo tối thiểu cho bữa này (không áp dụng cho WATER)
  targetCalorieMax Float?

  waterIntervalMinutes Int? // Chỉ dùng khi type = WATER — nhắc lại sau mỗi N phút

  repeatDays           Int[] @default([1, 2, 3, 4, 5, 6, 7]) // ISO weekday: 1=Thứ 2 ... 7=Chủ nhật
  advanceNoticeMinutes Int   @default(0) // 0 = đúng giờ, hoặc báo trước N phút

  sortOrder Int @default(0)

  foods HabitReminderFood[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sortOrder])
}

// Món ăn cụ thể được gắn vào 1 Habit Reminder (VD "Salad gà & chà là" gắn vào Bữa Tối).
// Lưu snapshot dinh dưỡng tại thời điểm gắn — không tham chiếu cứng CustomFood để không vỡ nếu
// món gốc bị sửa/xoá sau này.
model HabitReminderFood {
  id              String        @id @default(uuid())
  habitReminderId String
  habitReminder   HabitReminder @relation(fields: [habitReminderId], references: [id], onDelete: Cascade)

  name        String
  servingSize String?
  calories    Float
  protein     Float
  carb        Float
  fat         Float

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Mỗi lần user uống 1 ly nước (bấm + trên dashboard). Tổng theo ngày = SUM(amountMl).
model WaterLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl Int
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

// Thông báo trong app (nhắc bữa ăn, nhắc uống nước, đạt/vượt mục tiêu, tin từ AI).
// Khác với ReminderWorker (bắn notification hệ thống Android cục bộ) — đây là nguồn sự thật
// phía server cho màn hình Thông báo trong app, để đồng bộ giữa nhiều thiết bị của cùng 1 user.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

enum NotificationType {
  CHECKIN_READY // Check-in tuần vừa được tạo (BR-13.1)
  DAY_COMPLETED // ngày đã kết thúc có calo trong 85–115% mục tiêu
  BILLING_ISSUE // gia hạn Premium lỗi hoặc hết ân hạn (BR-16.6)
  WEEKLY_SUMMARY_READY // tổng kết tuần được tạo (Premium)
  FOOD_SUBMISSION_RESULT // admin duyệt hoặc từ chối món người dùng gửi (E9)
  GOAL_REACHED // cân nặng chạm cân đích của Goal, kèm gợi ý chuyển sang Duy trì
  PAYMENT_SUCCESS // đơn QR đã được duyệt, Premium đã kích hoạt (luôn gửi)
  WORKOUT_REMINDER // nhắc ghi buổi tập khi người tập đều có dấu hiệu quên ghi (tối đa 1 lần/ngày)
  // Đã bỏ GOAL_EXCEEDED, GOAL_ACHIEVED, AI_MESSAGE (trái nguyên tắc không phán xét / đã có loại thay thế)
  // và MEAL_REMINDER, WATER_REMINDER (là thông báo cục bộ trên máy, không lưu server).
}

// Bộ đếm hạn mức AI theo ngày (BR-11.4). Mỗi (user, ngày theo múi giờ user) một dòng.
// Trừ lượt bằng UPDATE có điều kiện `aiPhoto < limit` nên an toàn khi nhiều request chạy đồng thời.
// `date` là chuỗi YYYY-MM-DD tính theo User.timezone. chatTokens/chatMessages dành cho chuyển hạn mức chat sang cùng cơ chế.
model UsageCounter {
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String
  aiPhoto        Int    @default(0)
  chatTokens     Int    @default(0)
  chatMessages   Int    @default(0)
  menuScans      Int    @default(0) // quét thực đơn (AI_MENU_SCAN)
  suggestMeals   Int    @default(0) // gợi ý món bằng AI (AI_SUGGEST_MEAL)
  barcodeLookups Int    @default(0) // tra mã vạch (BARCODE)

  @@id([userId, date])
}

// Nguồn thay đổi mục tiêu calo/macro (BR-04). Mục tiêu chỉ được đổi qua các sự kiện này.
enum TargetChangeSource {
  ONBOARDING // E1: hoàn tất Onboarding
  GOAL_CHANGE // E2: user đổi mục tiêu (Giảm/Duy trì/Tăng, cân đích, tốc độ) và xác nhận
  CHECKIN_ACCEPTED // E3: chấp nhận Weekly Check-in
  MANUAL // E4: user tự đặt mục tiêu (chế độ MANUAL)
  PROFILE_RECALC // E5: user bấm "Tính lại mục tiêu" sau khi đổi hồ sơ
}

// Lịch sử thay đổi mục tiêu: mỗi lần mục tiêu đổi có đúng một dòng.
model TargetChange {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      TargetChangeSource
  oldCalories Float?
  newCalories Float?
  oldMacros   Json?
  newMacros   Json?
  checkinId   String?
  createdAt   DateTime           @default(now())

  @@index([userId, createdAt])
}

// Mục tiêu calo bị giới hạn an toàn bởi quy tắc nào (BR-03.3). null = không bị giới hạn.
enum TargetLimit {
  FLOOR // chạm sàn calo (theo giới và BMR)
  DEFICIT_CAP // thâm hụt bị chặn ở mức tối đa % của mức nền
  SURPLUS_CAP // thặng dư bị chặn ở mức tối đa % của mức nền
}

// Trạng thái "đầy đủ" của một ngày ghi bữa ăn (BR-05.2): người dùng tự đánh dấu hoặc để hệ thống tự quyết định.
enum DayCompleteness {
  AUTO // để hệ thống quyết định theo quy tắc tự động (≥ 2 bữa và ≥ 60% mục tiêu)
  COMPLETE // người dùng xác nhận "Đã ghi đủ hôm nay"
  INCOMPLETE // người dùng xác nhận "Hôm nay ghi chưa đủ" — ngày bị loại khỏi tính toán
}

model DailyLogStatus {
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate      DateTime        @db.Date
  completeness DayCompleteness @default(AUTO)
  updatedAt    DateTime        @updatedAt

  @@id([userId, logDate])
}

// ---------------------------------------------------------------------------
// BR-16: Thanh toán Google Play (subscription), xác minh ở server
// ---------------------------------------------------------------------------
enum SubStatus {
  PENDING
  ACTIVE
  CANCELED
  IN_GRACE_PERIOD
  ON_HOLD
  PAUSED
  EXPIRED
  REVOKED
}

model Product {
  productId String  @id // premium_monthly, premium_yearly
  type      String  @default("SUBSCRIPTION")
  isActive  Boolean @default(true)
}

model Purchase {
  id                  String   @id @default(uuid())
  purchaseToken       String   @unique // khoá idempotency
  orderId             String?
  userId              String? // null khi user đã xoá tài khoản
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId           String
  purchaseTime        DateTime
  acknowledged        Boolean  @default(false)
  linkedPurchaseToken String?
  rawResponse         Json
  createdAt           DateTime @default(now())

  @@index([userId])
}

model SubscriptionState {
  userId               String    @id
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId            String
  status               SubStatus
  expiryTime           DateTime
  autoRenewing         Boolean
  isTrial              Boolean   @default(false)
  currentPurchaseToken String
  lastReconciledAt     DateTime?
  updatedAt            DateTime  @updatedAt
}

model ManualGrant {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null khi quyền đến từ đơn QR tự duyệt qua ngân hàng (không có admin); xem `source`
  adminId   String?
  source    String    @default("ADMIN") // ADMIN | QR_ORDER
  orderCode String? // mã đơn QR khi source = QR_ORDER
  reason    String
  startsAt  DateTime
  endsAt    DateTime
  revokedAt DateTime?
  revokedBy String?

  @@index([userId])
}

model BillingEvent {
  id            String   @id @default(uuid())
  purchaseToken String?
  userId        String?
  type          String // VERIFY, RTDN_<loại>, RECONCILE, ADMIN_GRANT, ADMIN_REVOKE
  messageId     String?  @unique // idempotency cho RTDN
  actorId       String?
  payload       Json
  createdAt     DateTime @default(now())

  @@index([userId])
}

// Thanh toán bằng QR ngân hàng (VietQR). Admin đối chiếu sao kê rồi duyệt đơn để cấp Premium.
enum PaymentOrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
}

model PaymentOrder {
  id         String             @id @default(uuid())
  code       String             @unique // nội dung chuyển khoản, ví dụ NWK7M2QX9A
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  amount     Int // VND
  status     PaymentOrderStatus @default(PENDING)
  expiresAt  DateTime
  paidAt     DateTime?
  approvedBy String?
  adminNote  String? // ghi chú nội bộ của admin khi đối soát
  createdAt  DateTime           @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
}

// Mục tiêu cân nặng hiện hành (BR-09.5). Tại mọi thời điểm một user chỉ có MỘT Goal ACTIVE.
// Đổi loại mục tiêu hoặc cân đích tạo Goal mới và đóng Goal cũ; tiến độ tính từ startWeight của Goal.
enum GoalStatus {
  ACTIVE
  ENDED
}

model Goal {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalType      GoalType
  startWeight   Float
  startDate     DateTime   @default(now())
  targetWeight  Float?
  rateKgPerWeek Float?
  status        GoalStatus @default(ACTIVE)
  endedAt       DateTime?
  reachedNotifiedAt DateTime? // đã gửi thông báo GOAL_REACHED cho Goal này (một lần mỗi Goal)

  @@index([userId, status])
}

// Nhật ký kiểm toán hành động quản trị (BR-17.1). Bảng chỉ thêm (append-only), cấm sửa/xoá.
model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  adminEmail String?
  action     String   // LOGIN, APPROVE_PAYMENT, REJECT_PAYMENT, GRANT_PREMIUM, REVOKE_PREMIUM, ...
  targetType String   // User, PaymentOrder, ManualGrant
  targetId   String?
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}


// Món người dùng gửi vào kho chung, chờ admin duyệt (BR-08.5).
// SUBMITTED -> APPROVED | REJECTED | CANCELED. Món tự tạo gốc của người dùng giữ nguyên.
model FoodSubmission {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customFoodId      String? // món tự tạo gốc (có thể đã bị xoá sau đó)
  name              String
  nameNormalized    String
  servingSize       String
  calories          Float
  protein           Float
  carb              Float
  fat               Float
  barcode           String?
  note              String?
  status            String    @default("SUBMITTED")
  possibleDuplicate Boolean   @default(false)
  duplicateOfName   String? // tên món gần giống trong kho khi bị gắn cờ trùng
  rejectReason      String?
  reviewedBy        String?
  reviewedAt        DateTime?
  catalogFoodId     String? // món được tạo trong kho khi APPROVED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

// Tham số hệ thống (BR-19.2): chỉ lưu giá trị ghi đè; mặc định nằm trong code (config.registry.ts).
model SystemConfig {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Lịch sử thay đổi tham số: chỉ thêm, không sửa/xoá. configVersion tăng sau mỗi lần sửa.
model SystemConfigHistory {
  id            String   @id @default(uuid())
  key           String
  action        String // SET | RESET | RESTORE
  oldValue      Json?
  newValue      Json?
  adminId       String
  adminEmail    String?
  reason        String
  configVersion Int
  createdAt     DateTime @default(now())

  @@index([key, createdAt])
  @@index([configVersion])
}

// Xác thực hai lớp TOTP cho ADMIN (BR-17.5). Bí mật mã hoá AES-256-GCM; mã dự phòng chỉ lưu băm, dùng một lần.
model AdminTotp {
  userId          String    @id
  secretEnc       String
  enabled         Boolean   @default(false)
  enabledAt       DateTime?
  lastUsedStep    Int? // bước 30 giây của mã đã dùng gần nhất (chống dùng lại)
  backupCodeHashes String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Kho bài tập trong DB (F1, J2): admin thêm/sửa/ẩn không cần deploy. `data` giữ nguyên toàn bộ hướng dẫn của bài;
// các cột còn lại phục vụ tìm kiếm và lọc.
model ExerciseCatalog {
  id             String   @id
  name           String
  nameNormalized String
  genderTarget   String // MALE | FEMALE | ALL
  level          String // BEGINNER | INTERMEDIATE | ADVANCED
  targetMuscle   String
  equipment      String
  data           Json
  source         String   @default("OFFICIAL") // OFFICIAL | ADMIN
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([genderTarget, level, isActive])
  @@index([nameNormalized])
}

// Yêu cầu quyền dữ liệu của người dùng (xuất bản sao, xoá, khiếu nại), ghi nhận qua email và xử lý trong web admin.
// userId để trống nếu email không khớp tài khoản nào (hoặc tài khoản đã bị xoá).
model DataRequest {
  id          String    @id @default(uuid())
  userId      String?
  email       String
  type        String // EXPORT | DELETE | COMPLAINT
  note        String?
  status      String    @default("NEW") // NEW | IN_PROGRESS | DONE | REJECTED
  dueAt       DateTime
  handledBy   String?
  handledAt   DateTime?
  resultNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, dueAt])
  @@index([email])
}
